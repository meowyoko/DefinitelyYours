# The Windows launcher saves voice settings in phone-test/.env.
# When testing without its settings page, uncomment the desired provider.
# PHONE_TTS_PROVIDER=off
ELEVENLABS_API_KEY=
PHONE_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3

# OpenAI-compatible TTS (full endpoint, returns MP3 audio)
# PHONE_TTS_URL=http://127.0.0.1:8000/v1/audio/speech
# PHONE_TTS_MODEL=
# PHONE_TTS_VOICE=
# PHONE_TTS_API_KEY=
