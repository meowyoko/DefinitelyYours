# Copy to ~/.claude/channels/game-phone/.env and fill in.
# Values in .env override the inherited environment.

# Required. Long random string; the mod sends it as X-Phone-Token.
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
PHONE_TOKEN=CHANGE_ME

# Where the HTTP line listens. Keep 127.0.0.1 when the game runs on the same PC.
# For remote play, put an HTTPS reverse proxy in front (see deploy/nginx-phone.conf);
# if that proxy runs in Docker, use the Docker gateway IP here instead of 0.0.0.0.
PHONE_HOST=127.0.0.1
PHONE_PORT=3900

# How long one turn waits for the AI before the game hears "signal lost".
PHONE_TIMEOUT_MS=42000

# wav | ogg | mp3 (wav/ogg need ffmpeg on PATH)
PHONE_AUDIO_FORMAT=wav

# Optional voice (ElevenLabs). Leave empty for text only.
ELEVENLABS_API_KEY=
PHONE_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3

# 1 = open the line at startup instead of waiting for phone_open
PHONE_AUTO_OPEN=0
