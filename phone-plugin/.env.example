# Copy to ~/.claude/channels/game-phone/.env and fill in.
# Values in .env override the inherited environment.

# Required. Long random string; the mod sends it as X-Phone-Token.
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
PHONE_TOKEN=CHANGE_ME

# Where the HTTP line listens. Keep 127.0.0.1 when the game runs on the same PC.
# For remote play, put an HTTPS reverse proxy in front (see deploy/nginx-phone.conf);
# if that proxy runs in Docker, use the Docker gateway IP here instead of 0.0.0.0.
PHONE_HOST=127.0.0.1
PHONE_PORT=3900

# How long one turn waits for the AI before the game hears "signal lost".
PHONE_TIMEOUT_MS=42000

# claude = existing Claude Code channel, cli = launch an agent, poll = phone_wait.
PHONE_WAKE_MODE=claude
# Required in cli/poll. AI clients send this as an MCP bearer token.
# PHONE_MCP_TOKEN=CHANGE_ME

# CLI mode. Use JSON argument arrays. The child receives UTF-8 on stdin.
# On Windows, use the absolute executable path (or node.exe plus the CLI entry JS).
# PHONE_CLI_CREATE=["codex","exec","--skip-git-repo-check","--json","-"]
# PHONE_CLI_RESUME=["codex","exec","resume","--skip-git-repo-check","--json","{session}","-"]
# PHONE_CLI_CWD=C:/your/phone-workspace
# Optional stable name. Keep it the same while changing launch paths or options
# for the same agent session store. Choose a different name for a different agent.
# PHONE_CLI_PROFILE=my-agent
# Optional JSON field or dotted path in a stdout event, e.g. session_id or session.id.
# Omit to recognize Codex thread_id and DSH sessionId automatically.
# PHONE_CLI_SESSION_FIELD=session_id
# Initialization and daily reports have their own process runtime limit.
# PHONE_CLI_BACKGROUND_TIMEOUT=300

# wav | ogg | mp3 (wav/ogg need ffmpeg on PATH)
PHONE_AUDIO_FORMAT=wav

# Voice provider: off | elevenlabs | openai.
# If omitted, old ElevenLabs credentials still enable ElevenLabs.
# PHONE_TTS_PROVIDER=off

# ElevenLabs
ELEVENLABS_API_KEY=
PHONE_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3

# OpenAI-compatible TTS. Use the complete speech endpoint and a model/voice
# supported by your provider. An unauthenticated self-hosted service can omit the key.
# PHONE_TTS_URL=http://127.0.0.1:8000/v1/audio/speech
# PHONE_TTS_MODEL=
# PHONE_TTS_VOICE=
# PHONE_TTS_API_KEY=

# 1 = open the line at startup instead of waiting for phone_open
PHONE_AUTO_OPEN=0
